nextflow_process {

    name "SAMTOOLS_ADDREPLACERG stub (hazel setup check)"
    script "../../modules/nf-core/samtools/addreplacerg/main.nf"
    process "SAMTOOLS_ADDREPLACERG"
    tag "hazel"
    tag "genotype"

    test("stub") {

        options "-stub"

        when {
            params {
                region = 'chrA'
            }
            process {
                """
                input[0] = [[id: 't', single_end: false, library: 'L', lanes: '1'], file("${projectDir}/tests/fixtures/genotype/cram/L_1.cram", checkIfExists: true), file("${projectDir}/tests/fixtures/genotype/cram/L_1.cram.crai", checkIfExists: true), 'ID:t']
                input[1] = [[id: 'tiny'], file("${projectDir}/tests/fixtures/ref/tiny.fa", checkIfExists: true), file("${projectDir}/tests/fixtures/ref/tiny.fa.fai", checkIfExists: true), []]
                """
            }
        }

        then {
            assert process.success
        }
    }
}
