nextflow_process {

    name "SAMTOOLS_STATS stub (hazel setup check)"
    script "../../modules/nf-core/samtools/stats/main.nf"
    process "SAMTOOLS_STATS"
    tag "hazel"
    tag "alignment"

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [[id: 't', single_end: false, library: 'L', lanes: '1'], file("${projectDir}/tests/fixtures/genotype/cram/L_1.cram", checkIfExists: true), file("${projectDir}/tests/fixtures/genotype/cram/L_1.cram.crai", checkIfExists: true)]
                input[1] = [[id: 'tiny'], file("${projectDir}/tests/fixtures/ref/tiny.fa", checkIfExists: true), file("${projectDir}/tests/fixtures/ref/tiny.fa.fai", checkIfExists: true)]
                """
            }
        }

        then {
            assert process.success
        }
    }
}
