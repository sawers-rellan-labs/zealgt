nextflow_process {

    name "SAMTOOLS_INDEX stub (hazel setup check)"
    script "../../modules/nf-core/samtools/index/main.nf"
    process "SAMTOOLS_INDEX"
    tag "hazel"
    tag "alignment"

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [[id: 't', single_end: false, library: 'L', lanes: '1'], file("${projectDir}/tests/fixtures/genotype/cram/L_1.cram", checkIfExists: true)]
                """
            }
        }

        then {
            assert process.success
        }
    }
}
