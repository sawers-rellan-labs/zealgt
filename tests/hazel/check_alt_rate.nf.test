nextflow_process {

    name "CHECK_ALT_RATE stub (hazel setup check)"
    script "../../modules/local/check_alt_rate/main.nf"
    process "CHECK_ALT_RATE"
    tag "hazel"
    tag "genotype"

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [[id: 'Zx.0540_P3', donor: 'Zx.0540_P3', region: 'chrA'], file("${projectDir}/tests/fixtures/genotype/fill/union.vcf", checkIfExists: true)]
                """
            }
        }

        then {
            assert process.success
        }
    }
}
