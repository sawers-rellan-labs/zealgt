nextflow_process {

    name "BCFTOOLS_VIEW stub (hazel setup check)"
    script "../../modules/nf-core/bcftools/view/main.nf"
    process "BCFTOOLS_VIEW"
    tag "hazel"
    tag "genotype"

    test("stub") {

        options "-stub"

        when {
            params {
                region = 'chrA'
            }
            process {
                """
                input[0] = [[id: 'Zx.0540_P3', donor: 'Zx.0540_P3'], file("${projectDir}/tests/fixtures/genotype/fill/union.vcf", checkIfExists: true), file("${projectDir}/tests/fixtures/genotype/check_sites.vcf.gz.tbi", checkIfExists: true)]
                input[1] = []
                input[2] = []
                input[3] = []
                """
            }
        }

        then {
            assert process.success
        }
    }
}
