nextflow_process {

    name "FILL_DONOR_ALLELES stub (hazel setup check)"
    script "../../modules/local/fill_donor_alleles/main.nf"
    process "FILL_DONOR_ALLELES"
    tag "hazel"
    tag "genotype"

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [[id: 'Zx.0540_P3', donor: 'Zx.0540_P3', region: 'chrA'], file("${projectDir}/tests/fixtures/genotype/fill/union.vcf", checkIfExists: true), file("${projectDir}/tests/fixtures/genotype/known_sites.vcf.gz.tbi", checkIfExists: true), file("${projectDir}/tests/fixtures/genotype/fill/Zx.0540_P3.tier_a.vcf", checkIfExists: true), file("${projectDir}/tests/fixtures/genotype/fill/Zx.0540_P3.sites.tsv", checkIfExists: true), file("${projectDir}/tests/fixtures/genotype/score/zealbc1_Zx.0540_P3.sites.tsv", checkIfExists: true)]
                input[1] = file("${projectDir}/bin/fill_donor_alleles.py", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
        }
    }
}
