nextflow_process {

    name "ANCESTRY_GRID stub (hazel setup check)"
    script "../../modules/local/ancestry_grid/main.nf"
    process "ANCESTRY_GRID"
    tag "hazel"
    tag "genotype"

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [[id: 'Zx.0540_P3', donor: 'Zx.0540_P3', region: 'chrA'], file("${projectDir}/tests/fixtures/genotype/fill/union.vcf", checkIfExists: true), file("${projectDir}/tests/fixtures/genotype/known_sites.vcf.gz.tbi", checkIfExists: true), ['Zx.0540_P3'], [file("${projectDir}/tests/fixtures/genotype/fill/Zx.0540_P3.sites.tsv", checkIfExists: true)]]
                input[1] = file("${projectDir}/tests/fixtures/genotype/chrA_map.tsv", checkIfExists: true)
                input[2] = file("${projectDir}/bin/write_ancestry_grid.R", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
        }
    }
}
