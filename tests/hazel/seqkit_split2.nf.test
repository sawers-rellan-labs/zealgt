nextflow_process {

    name "SEQKIT_SPLIT2 stub (hazel setup check)"
    script "../../modules/nf-core/seqkit/split2/main.nf"
    process "SEQKIT_SPLIT2"
    tag "hazel"
    tag "alignment"

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [[id: 't', single_end: false, library: 'L', lanes: '1'], [file("${projectDir}/tests/fixtures/reads/SI_1_1.fq.gz", checkIfExists: true), file("${projectDir}/tests/fixtures/reads/SI_1_2.fq.gz", checkIfExists: true)]]
                """
            }
        }

        then {
            assert process.success
        }
    }
}
