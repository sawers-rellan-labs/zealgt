nextflow_process {

    name "CRISP stub (hazel setup check)"
    script "../../modules/local/crisp/main.nf"
    process "CRISP"
    tag "hazel"
    tag "genotype"

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [[id: 'Zx.0540_P3', donor: 'Zx.0540_P3', region: 'chrA'], [file("${projectDir}/tests/fixtures/genotype/cram/L_1.cram", checkIfExists: true)], [file("${projectDir}/tests/fixtures/genotype/cram/L_1.cram.crai", checkIfExists: true)], [file("${projectDir}/tests/fixtures/genotype/cram/L_1.cram", checkIfExists: true)], [file("${projectDir}/tests/fixtures/genotype/cram/L_1.cram.crai", checkIfExists: true)]]
                input[1] = [[id: 'tiny'], file("${projectDir}/tests/fixtures/ref/tiny.fa", checkIfExists: true), file("${projectDir}/tests/fixtures/ref/tiny.fa.fai", checkIfExists: true)]
                input[2] = file("${projectDir}/tests/fixtures/genotype/lowcopy.bed", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
        }
    }
}
