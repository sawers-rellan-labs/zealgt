nextflow_pipeline {

    name "Test --step genotype"
    script "../main.nf"
    tag "pipeline"
    tag "genotype"

    profile "test,docker"

    test("--step genotype - stub") {

        options "-stub"

        when {
            // nf-test launches in its own directory: the fixture sheets' relative paths are made absolute
            def (cram_sheet, controls_sheet) = ['samplesheet_cram.csv', 'b73_controls.csv'].collect { name ->
                def sheet = new File("$outputDir/$name")
                sheet.parentFile.mkdirs()
                sheet.text = new File("$baseDir/tests/fixtures/genotype/$name").text.replace('tests/fixtures/', "$baseDir/tests/fixtures/")
                sheet.path
            }.toList() // a bare closing brace here ends nf-core lint's scan of the when block before params
            params {
                outdir = "$outputDir"
                input        = cram_sheet
                step         = 'genotype'
                b73_controls = controls_sheet
                lowcopy_bed  = "$baseDir/tests/fixtures/genotype/lowcopy.bed"
                check_sites  = "$baseDir/tests/fixtures/genotype/check_sites.vcf.gz"
                region       = 'chrA'
            }
        }

        then {
            def tasks = workflow.trace.tasks().countBy { t -> t.name.tokenize(':')[-1].tokenize(' ')[0] }
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: false, ignore: ['pipeline_info/**', '*.csv'])*.toString()
            assert workflow.success
            assertAll(
                // 2 donors; B73-bulk checks C_1, C_2 (C_3 is a Purple check); pools: 2 witnesses (L_low under 0.05x,
                // L_excl excluded), the check pool, the B73 control; one mpileup per donor and B73 control
                { assert tasks == [CHECK_COUNTS: 2, CHECK_ALT_RATE: 2, SAMTOOLS_MERGE: 4, SAMTOOLS_ADDREPLACERG: 4, SAMTOOLS_INDEX: 4, CRISP: 2,
                                   BED_CLIP: 2, WITNESS_VETO: 2, BCFTOOLS_MPILEUP: 4, POOLED_LIKELIHOOD_TIERS: 2] },
                // the stub drops no check, so no dropped_b73_checks.tsv
                { assert stable_path.sort() == ['Zx.9001_P1', 'Zx.9002_P1'].collectMany { d ->
                    ["genotype/discovery/${d}.chrA.vcf.gz", "genotype/discovery/${d}.chrA.vcf.gz.tbi", "genotype/discovery/${d}.chrA.sites.tsv.gz"]
                }*.toString().sort() },
                // software versions as in the other pipeline tests
                { assert snapshot(removeNextflowVersion("$outputDir/pipeline_info/zealgt_software_mqc_versions.yml"), stable_path.sort()).match() }
            )
        }
    }

    test("--step genotype - fixtures") {

        when {
            // nf-test launches in its own directory: the fixture sheets' relative paths are made absolute
            def (cram_sheet, controls_sheet) = ['samplesheet_cram.csv', 'b73_controls.csv'].collect { name ->
                def sheet = new File("$outputDir/$name")
                sheet.parentFile.mkdirs()
                sheet.text = new File("$baseDir/tests/fixtures/genotype/$name").text.replace('tests/fixtures/', "$baseDir/tests/fixtures/")
                sheet.path
            }.toList() // a bare closing brace here ends nf-core lint's scan of the when block before params
            params {
                outdir = "$outputDir"
                input        = cram_sheet
                step         = 'genotype'
                b73_controls = controls_sheet
                lowcopy_bed  = "$baseDir/tests/fixtures/genotype/lowcopy.bed"
                check_sites  = "$baseDir/tests/fixtures/genotype/check_sites.vcf.gz"
                region       = 'chrA:1-5000'
            }
        }

        then {
            def d = "$outputDir/genotype/discovery"
            def sites = path("$d/Zx.9001_P1.chrA_1-5000.sites.tsv.gz").linesGzip.drop(1)*.tokenize('\t')
            def checks = path("$d/dropped_b73_checks.tsv").readLines()*.tokenize('\t')
            assert workflow.success
            assertAll(
                // CRISP calls 1000, 1101, 2000, 2500, 4000; 1101 lies one past a range end, the witness has no ALT read at 1000 and 2500
                { assert path("$d/Zx.9001_P1.chrA_1-5000.vcf.gz").linesGzip.findAll { l -> !l.startsWith('#') }*.tokenize('\t')*.getAt(1) == ['2000', '4000'] },
                // both BC1 pools carry ALT reads at both sites
                { assert sites.collect { r -> [r[1], r[9]] } == [['2000', 'A'], ['4000', 'A']] },
                // C_2 holds the witness's reads (ALT reads at the check sites): dropped; C_1 kept
                { assert checks*.getAt(0) == ['sample_id', 'C_2'] && (checks[1][3] as double) > 0.01 }
            )
        }
    }
}
