nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    // containers give real tool versions in the snapshot
    profile "test,docker"

    test("-profile test - stub") {

        options "-stub"

        when {
            // nf-test launches in its own directory: the fixture sheet's relative paths are made absolute
            def sheet = new File("$outputDir/samplesheet.csv")
            sheet.parentFile.mkdirs()
            sheet.text = new File("$baseDir/tests/fixtures/samplesheet.csv").text.replace('tests/fixtures/', "$baseDir/tests/fixtures/")
            params {
                outdir = "$outputDir"
                input  = sheet.path
            }
        }

        then {
            // every published path, one fixture library per kit
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // tasks per process: one per kept sample (6) from the lane join on; every sample has 2 lanes
            def tasks = workflow.trace.tasks().countBy { t -> t.name.tokenize(':')[-1].tokenize(' ')[0] }
            assert workflow.success
            assertAll(
                { assert ['CAT_FASTQ', 'MINIBWA_MAP', 'FGUMI_CLIP', 'SAMTOOLS_FIXMATE', 'SAMTOOLS_SORT', 'SAMTOOLS_MARKDUP', 'SAMTOOLS_INDEX', 'SAMTOOLS_STATS', 'PICARD_COLLECTWGSMETRICS', 'MOSDEPTH'].every { p -> tasks[p] == 6 } },
                { assert !tasks.containsKey('SAMTOOLS_MERGE') },
                { assert tasks.MULTIQC == 1 },
                { assert stable_path.findAll { p -> p.startsWith('cram/') }.sort() == ['LX_1', 'LX_2', 'LX_3', 'PB1_SID1', 'PB1_SID2', 'PB1_SID4'].collectMany { s ->
                    // the CRAM, then its QC (stub names); no mosdepth per-base file
                    ["cram/${s}.cram", "cram/${s}.cram.crai", "cram/${s}.stats", "cram/${s}.CollectWgsMetrics.coverage_metrics"] +
                    ['global.dist.txt', 'region.dist.txt', 'summary.txt', 'regions.bed.gz', 'regions.bed.gz.csi'].collect { x -> "cram/${s}.${x}" }
                }*.toString().sort() },
                { assert snapshot(
                    // pipeline versions.yml without the Nextflow version, as in the nf-core template
                    removeNextflowVersion("$outputDir/pipeline_info/zealgt_software_mqc_versions.yml"),
                    stable_path
                ).match() }
            )
        }
    }

    test("-profile test - MultiQC") {

        when {
            def sheet = new File("$outputDir/samplesheet.csv")
            sheet.parentFile.mkdirs()
            sheet.text = new File("$baseDir/tests/fixtures/samplesheet.csv").text.replace('tests/fixtures/', "$baseDir/tests/fixtures/")
            params {
                outdir = "$outputDir"
                input  = sheet.path
            }
        }

        then {
            // samples MultiQC parsed, per module and section
            def sources = path("$outputDir/multiqc/multiqc_data/multiqc_sources.txt").readLines().drop(1)*.tokenize('\t')
                .groupBy { r -> "${r[0]} ${r[1]}".toString() }.collectEntries { k, rs -> [k, rs*.getAt(2).sort()] }
            def kept = ['LX_1', 'LX_2', 'LX_3', 'PB1_SID1', 'PB1_SID2', 'PB1_SID4']
            assertAll(
                { assert workflow.success },
                { assert sources.keySet().sort() == ['Mosdepth genome_results', 'Mosdepth summary', 'Picard WgsMetrics', 'Samtools stats'] },
                { assert sources.every { _k, samples -> samples == kept } }
            )
        }
    }
}
