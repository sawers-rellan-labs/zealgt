nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    // containers give real tool versions in the snapshot
    profile "test,docker"

    test("--step demultiplex - stub") {

        options "-stub"

        when {
            // nf-test launches in its own directory: the fixture sheet's relative paths are made absolute
            def sheet = new File("$outputDir/samplesheet.csv")
            sheet.parentFile.mkdirs()
            sheet.text = new File("$baseDir/tests/fixtures/samplesheet.csv").text.replace('tests/fixtures/', "$baseDir/tests/fixtures/")
            params {
                outdir = "$outputDir"
                input  = sheet.path
                step   = 'demultiplex'
            }
        }

        then {
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def tasks = workflow.trace.tasks().countBy { t -> t.name.tokenize(':')[-1].tokenize(' ')[0] }
            def kept = ['LX_1', 'LX_2', 'LX_3', 'PB1_SID1', 'PB1_SID2', 'PB1_SID4']
            // the published samplesheet: one quoted row per kept sample, paths to the published files
            def lines = path("$outputDir/fastq/samplesheet.csv").readLines()
            def expected = kept.collect { s ->
                def (lib, lanes, kit) = s.startsWith('LX_') ? ['LIBX', 'LIBX_TESTFC01_L1,LIBX_TESTFC01_L2', 'twist_flexprep'] : ['LIBB1', 'LIBB1_S1_L001,LIBB1_S1_L002', 'twist_96plex']
                [s, "$outputDir/fastq/${s}/${s}_R1.fastq.gz", "$outputDir/fastq/${s}/${s}_R2.fastq.gz", lib, lanes, kit].collect { v -> "\"${v}\"" }.join(',')
            }
            assert workflow.success
            assertAll(
                // 2 tar lanes extracted, fqtk per lane (2 per library), one lane join per kept sample
                { assert tasks == [EXTRACT_LANE: 2, FQTK: 4, CAT_FASTQ: 6] },
                { assert stable_path.findAll { p -> p.startsWith('fastq/') && p.endsWith('.fastq.gz') }*.toString().sort() ==
                    kept.collectMany { s -> ["fastq/${s}/${s}_R1.fastq.gz", "fastq/${s}/${s}_R2.fastq.gz"] }*.toString().sort() },
                { assert lines[0] == '"sample_id","fastq_1","fastq_2","library","lanes","kit"' },
                { assert lines.drop(1).sort() == expected*.toString().sort() },
                { assert !stable_path.any { p -> p.startsWith('cram') } },
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/zealgt_software_mqc_versions.yml"),
                    stable_path
                ).match() }
            )
        }
    }

    test("--step alignment --head 10 - stub") {

        options "-stub"

        when {
            def sheet = new File("$outputDir/samplesheet.csv")
            sheet.parentFile.mkdirs()
            sheet.text = new File("$baseDir/tests/fixtures/samplesheet_fastq.csv").text.replace('tests/fixtures/', "$baseDir/tests/fixtures/")
            params {
                outdir = "$outputDir"
                input  = sheet.path
                step   = 'alignment'
                head   = 10
            }
        }

        then {
            // every published path, one fixture library per kit
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // tasks per process: one per sample (6), the head cut included; no demultiplexing
            def tasks = workflow.trace.tasks().countBy { t -> t.name.tokenize(':')[-1].tokenize(' ')[0] }
            assert workflow.success
            assertAll(
                { assert ['SEQKIT_HEAD', 'MINIBWA_MAP', 'FGUMI_CLIP', 'SAMTOOLS_FIXMATE', 'SAMTOOLS_SORT', 'SAMTOOLS_MARKDUP', 'SAMTOOLS_INDEX', 'SAMTOOLS_STATS', 'PICARD_COLLECTWGSMETRICS', 'MOSDEPTH'].every { p -> tasks[p] == 6 } },
                { assert !tasks.keySet().intersect(['EXTRACT_LANE', 'FQTK', 'CAT_FASTQ', 'SAMTOOLS_MERGE']) },
                { assert tasks.MULTIQC == 1 },
                { assert !stable_path.any { p -> p.startsWith('fastq') } },
                { assert stable_path.findAll { p -> p.startsWith('cram/') }.sort() == ['LX_1', 'LX_2', 'LX_3', 'PB1_SID1', 'PB1_SID2', 'PB1_SID4'].collectMany { s ->
                    // the CRAM, then its QC and duplicate counts (stub names); no mosdepth per-base file
                    ["cram/${s}.cram", "cram/${s}.cram.crai", "cram/${s}.markdup.stats", "cram/${s}.stats", "cram/${s}.CollectWgsMetrics.coverage_metrics"] +
                    ['global.dist.txt', 'region.dist.txt', 'summary.txt', 'regions.bed.gz', 'regions.bed.gz.csi'].collect { x -> "cram/${s}.${x}" }
                }*.toString().sort() },
                { assert snapshot(
                    // pipeline versions.yml without the Nextflow version, as in the nf-core template
                    removeNextflowVersion("$outputDir/pipeline_info/zealgt_software_mqc_versions.yml"),
                    stable_path
                ).match() }
            )
        }
    }

    test("--step alignment - MultiQC") {

        when {
            def sheet = new File("$outputDir/samplesheet.csv")
            sheet.parentFile.mkdirs()
            sheet.text = new File("$baseDir/tests/fixtures/samplesheet_fastq.csv").text.replace('tests/fixtures/', "$baseDir/tests/fixtures/")
            params {
                outdir = "$outputDir"
                input  = sheet.path
                step   = 'alignment'
            }
        }

        then {
            // samples MultiQC parsed, per module and section
            def sources = path("$outputDir/multiqc/multiqc_data/multiqc_sources.txt").readLines().drop(1)*.tokenize('\t')
                .groupBy { r -> "${r[0]} ${r[1]}".toString() }.collectEntries { k, rs -> [k, rs*.getAt(2).sort()] }
            def kept = ['LX_1', 'LX_2', 'LX_3', 'PB1_SID1', 'PB1_SID2', 'PB1_SID4']
            assertAll(
                { assert workflow.success },
                { assert sources.keySet().sort() == ['Mosdepth genome_results', 'Mosdepth summary', 'Picard WgsMetrics', 'Samtools markdup', 'Samtools stats'] },
                { assert sources.every { _k, samples -> samples == kept } }
            )
        }
    }
}
