%%metro title: sawers-rellan-labs/zealgt
%%metro style: nfcore
%%metro file: samples_in | CSV
%%metro file: fastq_sheet | FASTQ
%%metro file: cram_out | CRAM
%%metro file: reads_report | HTML
%%metro line: demultiplex | --step demultiplex | #2db572
%%metro line: alignment | --step alignment | #0570b0
%%metro line: variant_calling | --step variant_calling | #e6550d
%%metro line: ancestry | --step ancestry | #756bb1
%%metro file: b73_in | CRAM | B73 checks
%%metro file: alleles_out | VCF | donor alleles
%%metro file: counts_out | CSV | counts sheet
%%metro file: ancestry_out | VCF | ancestry
%%metro file: regions_in | LIST | --regions
%%metro off_track: b73_in
%%metro off_track: regions_in
%%metro legend: bl
%%metro grid: demux | 0,0
%%metro grid: align | 0,1
%%metro grid: geno | 0,2
%%metro grid: anc | 0,3

graph LR
    subgraph demux [Demultiplex]
        %%metro exit: right | alignment
        samples_in[samplesheet]
        extract_lane_d[untar]
        fqtk[fqtk]
        cat_fastq[cat]
        fastq_sheet[fastq]
        sequali[sequali]
        multiqc_reads[multiqc]
        reads_report[ ]

        samples_in -->|demultiplex| extract_lane_d
        extract_lane_d -->|demultiplex| fqtk
        fqtk -->|demultiplex| cat_fastq
        cat_fastq -->|demultiplex| fastq_sheet
        cat_fastq -->|demultiplex| sequali
        sequali -->|demultiplex| multiqc_reads
        multiqc_reads -->|demultiplex| reads_report
    end

    subgraph align [Alignment]
        %%metro entry: left | alignment
        %%metro exit: right | variant_calling
        split[seqkit split2]
        minibwa[minibwa]
        fgumi[fgumi clip]
        fixmate[fixmate]
        merge[merge]
        markdup[markdup]
        index[index]
        cram_out[cram]

        split -->|alignment| minibwa
        minibwa -->|alignment| fgumi
        fgumi -->|alignment| fixmate
        fixmate -->|alignment| merge
        merge -->|alignment| markdup
        markdup -->|alignment| index
        index -->|alignment| cram_out
    end


    subgraph geno [Variant calling]
        %%metro entry: left | variant_calling
        %%metro exit: right | ancestry
        filter[no supplementary]
        crisp[CRISP]
        veto[witness veto]
        b73_in[ ]
        regions_in[ ]
        tiers[pooled likelihood]
        union[sites union]
        site_counts[site counts]
        fill[gap filling]
        merge_alleles[merge]
        alleles_out[donor alleles]
        count_lines[mpileup lines]
        counts_out[counts]

        filter -->|variant_calling| crisp
        regions_in -->|variant_calling| crisp
        crisp -->|variant_calling| veto
        veto -->|variant_calling| tiers
        b73_in -->|variant_calling| tiers
        tiers -->|variant_calling| union
        union -->|variant_calling| site_counts
        site_counts -->|variant_calling| fill
        union -->|variant_calling| fill
        fill -->|variant_calling| merge_alleles
        merge_alleles -->|variant_calling| alleles_out
        merge_alleles -->|variant_calling| count_lines
        count_lines -->|variant_calling| counts_out
        union -->|variant_calling| counts_out
    end

    subgraph anc [Ancestry]
        %%metro entry: left | ancestry
        rtiger[RTIGER]
        grid[0.1 cM grid]
        ancestry_out[ancestry]

        rtiger -->|ancestry| grid
        grid -->|ancestry| ancestry_out
    end

    cram_out -->|variant_calling| filter
    counts_out -->|ancestry| rtiger
    fastq_sheet -->|alignment| split
