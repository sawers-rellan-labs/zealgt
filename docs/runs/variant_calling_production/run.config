// Run config of docs/runs/variant_calling_production.md: up to 400 tasks in flight (hpc_prod: 80, ~100-170 CPUs);
// hazel allows ~768 running CPUs and 1,000 submitted jobs per user
executor {
    queueSize = 400
}

// CRISP Zl.0020_P3 chr1 segfaulted at 1.79 of 2 GB (read queue 462k at chr1:206.96 Mb, job 1353412_10); exit 1 is not retried
process {
    withName: 'CRISP' { memory = { 6.GB * task.attempt } }
}
