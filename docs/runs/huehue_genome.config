// Run config of docs/runs/huehue_genome.md: Slurm polled every 10 s, as conf/stub_hazel.config (each of the ~18 steps
// otherwise waits up to a minute for the next status poll); CALL_ANCESTRY for the first genome-wide RTIGER fit,
// ~750k markers per donor (chr10: 52-56k, 0.37 GB, 0.7 min), unmeasured: its trace sets the resources in RESOURCES.md
executor {
    queueStatInterval = '10s'
    pollInterval      = '10s'
}

process {
    withName: 'CALL_ANCESTRY' { cpus = 1; memory = 16.GB; time = 2.h }
}
