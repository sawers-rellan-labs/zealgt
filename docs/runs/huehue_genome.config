// Run config of docs/runs/huehue_genome.md: the Slurm queue read every 10 s (default 1 min), as conf/stub_hazel.config;
// finished tasks are found every 5 s already (grid default pollInterval). CALL_ANCESTRY for the first genome-wide
// RTIGER fit, ~750k markers per donor (chr10: 52-56k, 0.37 GB, 0.7 min), unmeasured: its trace sets RESOURCES.md
executor {
    queueStatInterval = '10s'
}

process {
    withName: 'CALL_ANCESTRY' { cpus = 1; memory = 16.GB; time = 2.h }
}
