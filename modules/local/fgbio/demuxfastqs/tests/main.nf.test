nextflow_process {

    name "Test Process FGBIO_DEMUXFASTQS"
    script "../main.nf"
    process "FGBIO_DEMUXFASTQS"
    config "../../../../../conf/modules.config"
    tag "modules"
    tag "modules_local"
    tag "fgbio/demuxfastqs"

    // module tests run the tool in its container; the pipeline stub test needs none
    profile "test,docker"

    test("twist_flexprep lane") {

        when {
            process {
                """
                input[0] = channel.of([
                    [ id: 'LIBX.L1', library: 'LIBX', kit: 'twist_flexprep', lane: 'L1', n_lanes: 1 ],
                    file("${projectDir}/tests/fixtures/raw/LIBX/LIBX_TESTFC01_L1_1.fq.gz", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/raw/LIBX/LIBX_TESTFC01_L1_2.fq.gz", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/demux_sheets/LIBX.csv", checkIfExists: true),
                ])
                """
            }
        }

        then {
            def reads = process.out.reads[0][1].collectEntries { f -> [file(f).name, path(f).linesGzip] }
            assertAll(
                { assert process.success },
                // 150 pairs per sample, the barcode (6) and skipped bases (2) removed from 108-bp reads
                { assert reads.keySet().sort() == ['LX_1', 'LX_2', 'LX_3'].collectMany { s -> ["${s}_R1.fastq.gz", "${s}_R2.fastq.gz"] } },
                { assert reads.every { _n, lines -> lines.size() == 4 * 150 } },
                { assert reads.every { _n, lines -> (0..<150).every { i -> lines[4 * i + 1].size() == 100 } } },
                { assert path(process.out.metrics[0][1]).text.contains('unmatched\tunmatched\tNNNNNNNNNNNN\t20\t') }
            )
        }
    }

    test("twist_96plex lane from a tar member") {

        setup {
            run("EXTRACT_LANE") {
                script "../../../extract_lane/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id: 'LIBB1.L001', library: 'LIBB1', kit: 'twist_96plex', lane: 'L001', n_lanes: 1 ],
                        file("${projectDir}/tests/fixtures/raw/LIBB1/R1.tar", checkIfExists: true),
                        file("${projectDir}/tests/fixtures/raw/LIBB1/R2.tar", checkIfExists: true),
                        'LIBB1_R1/LIBB1_S1_L001_R1_001.fastq.gz',
                        'LIBB1_R2/LIBB1_S1_L001_R2_001.fastq.gz',
                        0,
                    ])
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = EXTRACT_LANE.out.reads.map { meta, r1, r2 ->
                    [ meta, r1, r2, file("${projectDir}/tests/fixtures/demux_sheets/LIBB1.csv", checkIfExists: true) ]
                }
                """
            }
        }

        then {
            def reads = process.out.reads[0][1].collectEntries { f -> [file(f).name, path(f).linesGzip] }
            def pairs = (1..4).collect { i -> reads["PB1_SID${i}_R1.fastq.gz"].size().intdiv(4) }
            assertAll(
                { assert process.success },
                // the fixture's assignment: 68 pairs, 30 / 20 / 10 / 0 to the samples, 8 unmatched
                { assert pairs == [30, 20, 10, 0] },
                // R1 loses the barcode (8) and random bases (12), R2 its random bases (8)
                { assert reads.findAll { n, _l -> n.endsWith('_R1.fastq.gz') }.every { _n, l -> (0..<l.size().intdiv(4)).every { i -> l[4 * i + 1].size() == 80 } } },
                { assert reads.findAll { n, _l -> n.endsWith('_R2.fastq.gz') }.every { _n, l -> (0..<l.size().intdiv(4)).every { i -> l[4 * i + 1].size() == 92 } } },
                { assert path(process.out.metrics[0][1]).text.contains('unmatched\tunmatched\tNNNNNNNN\t8\t') }
            )
        }
    }

    test("twist_flexprep lane - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([
                    [ id: 'LIBX.L1', library: 'LIBX', kit: 'twist_flexprep', lane: 'L1', n_lanes: 1 ],
                    file("${projectDir}/tests/fixtures/raw/LIBX/LIBX_TESTFC01_L1_1.fq.gz", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/raw/LIBX/LIBX_TESTFC01_L1_2.fq.gz", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/demux_sheets/LIBX.csv", checkIfExists: true),
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.reads[0][1].collect { f -> file(f).name }.sort() == ['LX_1', 'LX_2', 'LX_3'].collectMany { s -> ["${s}_R1.fastq.gz", "${s}_R2.fastq.gz"] } },
                { assert file(process.out.metrics[0][1]).name == 'LIBX.L1.demux_metrics.txt' }
            )
        }
    }
}
