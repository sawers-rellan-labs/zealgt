/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    // processes publish nothing unless listed below; stage results are workflow outputs (main.nf)
    publishDir = [ enabled: false ]

    // threads, and mismatches per kit as the Twist guides say (docs/decisions.md); read structures are inputs
    withName: 'FQTK' {
        ext.args = { "--threads ${task.cpus}" + (meta.kit == 'twist_flexprep' ? ' --max-mismatches 1 --min-mismatch-delta 2' : '') }
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            pattern: 'output/demux-metrics.txt',
            saveAs: { _fn -> "reports/demux/${meta.id}.demux_metrics.txt" }
        ]
    }

    // each sample's reads in chunks of 50 M pairs
    withName: 'SEQKIT_SPLIT2' {
        ext.args   = '--by-size 50000000'
    }

    // one read group per sample on every chunk: ID and SM = sample_id, PU lists its lanes
    withName: 'MINIBWA_MAP' {
        ext.args   = { "-x sr -R '@RG\\tID:${meta.id}\\tSM:${meta.id}\\tLB:${meta.library}\\tPL:ILLUMINA\\tPU:${meta.lanes}'" }
        ext.prefix = { "${meta.id}.${meta.chunk}" }
        // Apptainer pulls the Docker image (Ubuntu, has the module's `find`); the Wave SIF lacks `find`
        ext.singularity_pull_docker_container = true
    }

    // soft clips (fgumi's default is hard) of bases past the mate's end
    withName: 'FGUMI_CLIP' {
        ext.args   = '--clipping-mode soft --clip-bases-past-mate true'
        ext.prefix = { "${meta.id}.${meta.chunk}.clipped" }
    }

    // mate-score tags for markdup, on the clipped reads
    withName: 'SAMTOOLS_FIXMATE' {
        ext.args   = '-m'
        ext.prefix = { "${meta.id}.${meta.chunk}.fixmate" }
    }

    withName: 'SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}.${meta.chunk}.sorted" }
    }

    // the chunks' identical read group and program lines kept once each
    withName: '.*FASTQ_ALIGN_MINIBWA:SAMTOOLS_MERGE' {
        ext.args   = '-c -p'
        ext.prefix = { "${meta.id}.merged" }
    }

    // optical duplicate distance for patterned flow cells; duplicates flagged, not removed; counts as JSON for MultiQC
    withName: 'SAMTOOLS_MARKDUP' {
        ext.args   = { "-d 2500 --output-fmt cram --json -f ${meta.id}.markdup.stats" }
    }

    // raw depth as nf-core/sarek for WGS: no per-base output, 500 bp windows
    withName: 'MOSDEPTH' {
        ext.args   = '-n --fast-mode --by 500'
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    // one Sequali report per FASTQ pair
    withName: 'SEQUALI' {
        publishDir = [
            path: { "${params.outdir}/reports/sequali" },
            mode: params.publish_dir_mode
        ]
    }

    // the read-QC report, apart from the CRAM report, one per input sheet
    withName: '.*:FASTQ_SEQUALI:MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/multiqc/reads/${params.input.tokenize("/")[-1] - ~/\.csv$/}" },
            mode: params.publish_dir_mode
        ]
    }

    // alignment's --read_qc apart from demultiplexing's read QC, should both runs share an outdir
    withName: '.*:ALIGNMENT:FASTQ_SEQUALI:SEQUALI' {
        publishDir = [
            path: { "${params.outdir}/reports/sequali_alignment" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*:ALIGNMENT:FASTQ_SEQUALI:MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/multiqc/reads_alignment" },
            mode: params.publish_dir_mode
        ]
    }

    // GENOTYPE, variant discovery: zealbc1's step-4 settings (docs/milestones/07_variant_discovery.md)
    // B73 check filter: each check's reads at the check sites; -A keeps the ALT alleles call does not call, with their counts
    withName: 'CHECK_COUNTS' {
        ext.args  = '-I -a AD -q 20 -Q 20'
        ext.args2 = '-m -A'
    }

    // the witness, the B73 check pool and each B73 control, --region only
    withName: '.*CRAM_VARIANT_DISCOVERY_CRISP:SAMTOOLS_MERGE' {
        ext.args   = { "-R ${params.region}" }
        ext.prefix = { "${meta.id}.merged" }
    }
    withName: 'SAMTOOLS_ADDREPLACERG' {
        ext.args   = '-w -m overwrite_all'
    }

    // --region goes straight to --regions: with --bed, CRISP calls only the BED ranges inside it
    withName: 'CRISP' {
        ext.args   = { "--regions ${params.region} -p 12 --mmq 20 --mbq 20 --filterreads 0 --minc 2" }
        ext.prefix = { "${meta.id}.${params.region.replace(':', '_')}" }
    }
    withName: 'BED_CLIP' {
        ext.args   = '-Oz'
        ext.prefix = { "${meta.id}.${params.region.replace(':', '_')}.inbed" }
    }
    // a biallelic SNP stays if the witness (first sample) has an ALT read on either strand or both
    withName: 'WITNESS_VETO' {
        ext.args   = "-m2 -M2 -v snps -i 'FMT/ADf[0:1-]>=1 || FMT/ADr[0:1-]>=1 || FMT/ADb[0:1-]>=1' -Oz --write-index=tbi"
        ext.prefix = { "${meta.id}.${params.region.replace(':', '_')}" }
    }

    // the B73 controls at a donor's kept sites (decisions.md 2026-10-02); -A as for CHECK_COUNTS
    withName: 'BCFTOOLS_MPILEUP' {
        ext.args   = '-I -a AD -q 20 -Q 20'
        ext.args2  = '-m -A'
    }

    withName: 'POOLED_LIKELIHOOD_TIERS|UNION_TIERS' {
        ext.args   = [
            '--plants 6 --eps0 0.005 --eps-floor 0.001 --zero-class-llr -3 --zero-class-min-reads 20',
            '--llr-a 6.9 --llr-b 4.6 --llr-c 2.2 --llr-ref -4 --ref-min-depth 12 --a-min-pools-alt 2',
            '--hidepth-factor 2 --af-gt-half-min-depth 4 --af-gt-half-p 0.01 --inconsistent-min-alt 3 --inconsistent-min-depth 10',
        ].join(' ')
        ext.prefix = { "${meta.id}.${params.region.replace(':', '_')}" }
    }

    // GENOTYPE, sites union and gap filling, step 1 (docs/milestones/08_sites_union_gapfill.md)
    // the donors' tier-A sites (sites only, unindexed); one donor alone is a union too
    withName: 'BCFTOOLS_MERGE' {
        ext.args   = '-m none --no-index --force-single -Oz'
        ext.prefix = { "${params.region.replace(':', '_')}.union.merged" }
    }
    // different ALT alleles at one position become one record, which BIALLELIC_UNION drops (Text S5)
    withName: 'BCFTOOLS_NORM' {
        ext.args   = '-m +snps -Oz'
        ext.prefix = { "${params.region.replace(':', '_')}.union.norm" }
    }
    withName: 'BIALLELIC_UNION' {
        ext.args   = '-m2 -M2 -v snps -Oz --write-index=tbi'
        ext.prefix = { "${params.region.replace(':', '_')}.union" }
    }
    // each BC1 sample and B73 control at the union sites, --region through the CRAM index; -A as for CHECK_COUNTS
    withName: 'COUNT_UNION' {
        ext.args   = { "-I -a AD -q 20 -Q 20 -r ${params.region}" }
        ext.args2  = '-m -A'
    }
    withName: 'UNION_TIERS' {
        ext.prefix = { "${meta.id}.${params.region.replace(':', '_')}.union" }
    }
    withName: 'UNION_SITE_COUNTS' {
        ext.prefix = { "${params.region.replace(':', '_')}.site_counts" }
    }
    // Eq. eb: prior weight 2, ALT at posterior >= 0.999 (zealbc1, 2026-09-23)
    withName: 'FILL_DONOR_ALLELES' {
        ext.args   = '--w 2 --alt 0.999'
        ext.prefix = { "${meta.id}.${params.region.replace(':', '_')}.donor_alleles" }
    }
    // the donors' VCFs, one record per union site; one donor alone is a merge too
    withName: 'DONOR_ALLELES_MERGE' {
        ext.args   = '-m none --force-single --no-version -Oz --write-index=tbi'
        ext.prefix = { "${params.region.replace(':', '_')}.donor_alleles" }
    }

    // GENOTYPE, ancestry with RTIGER (docs/milestones/09_ancestry_rtiger.md)
    // each line at its donor's tier-A sites, as COUNT_UNION
    withName: 'COUNT_LINES' {
        ext.args   = { "-I -a AD -q 20 -Q 20 -r ${params.region}" }
        ext.args2  = '-m -A'
    }
    // rigidity 0.5 % of the donor's tier-A sites on the chromosome (user, 2026-10-05)
    withName: 'CALL_ANCESTRY' {
        ext.args   = '--rigidity-fraction 0.005 --seed 1'
        ext.prefix = { "${meta.id}.${params.region.replace(':', '_')}" }
    }
    withName: 'ANCESTRY_GRID' {
        ext.args   = '--min-cm 0.1'
        ext.prefix = { params.region.replace(':', '_') }
    }
    withName: 'ANCESTRY_VCF_INDEX' {
        ext.args   = '-Oz --write-index=tbi'
    }

}
