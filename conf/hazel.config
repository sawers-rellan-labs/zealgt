/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    hazel (NCSU): Slurm executor, Apptainer images from the /share cache
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Run by scripts/submit_head_job.sbatch; work/ is in its launch directory on /share.
----------------------------------------------------------------------------------------
*/

cleanup = true

// development outputs on /share as hard links: no extra space, and they outlive work/
params.publish_dir_mode = 'link'
workflow.output.mode    = 'link'

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = '/share/maize/frodrig4/apptainer/cache'
    runOptions = '-B /share/maize/frodrig4,/rsstu/users/r/rrellan/BZea'
}

executor {
    name                = 'slurm'
    queueSize           = 40
    submitRateLimit     = '20/1min'
    perCpuMemAllocation = false
}

process {
    queue          = 'compute_partners'
    clusterOptions = '--account=maize_cpu --qos=short'
    resourceLimits = [ cpus: 16, memory: 120.GB, time: 2.h ]

    // fqtk refuses fewer than 5 threads; peak 1.4-1.6 GB; a full lane ~22 min (BC1) to ~42 min (batch 1)
    withName: 'FQTK'         { cpus = 5; memory = 3.GB; time = 2.h }
    // provisional until a full-lane run: full lanes take the plain copy path, not the head path measured
    withName: 'EXTRACT_LANE' { cpus = 1; memory = 1.GB; time = 2.h }
    withName: 'CAT_FASTQ'    { cpus = 1; memory = 1.GB; time = 1.h }
}
