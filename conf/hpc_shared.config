/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    HPC settings shared by the hpc_dev and hpc_prod profiles (cluster: hazel, NCSU)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Run by scripts/submit_head_job.sbatch; work/ is in the profile's launch directory on /share.
----------------------------------------------------------------------------------------
*/

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = '/share/maize/frodrig4/apptainer/cache'
    runOptions = '-B /share/maize/frodrig4,/rsstu/users/r/rrellan/BZea'
}

// B73 v5 by its MaizeGDB name; its minibwa 0.7 index next to it (meta/PROVENANCE.md)
params {
    fasta         = '/rsstu/users/r/rrellan/BZea/ZEAL/reference/Zm-B73-REFERENCE-NAM-5.0.fa'
    minibwa_index = '/rsstu/users/r/rrellan/BZea/ZEAL/reference/Zm-B73-REFERENCE-NAM-5.0.fa.{l2b,mbw}'
}

executor {
    name                = 'slurm'
    queueSize           = 40
    submitRateLimit     = '20/1min'
    perCpuMemAllocation = false
}

process {
    queue          = 'compute_partners'
    clusterOptions = '--account=maize_cpu --qos=short'
    resourceLimits = [ cpus: 16, memory: 120.GB, time: 2.h ]
}
