/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    hpc_dev: development runs on heads of one library
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Outputs published as hard links; work/ kept so -resume reruns only what changed.
----------------------------------------------------------------------------------------
*/

// outputs on /share as hard links: no extra space, and they outlive work/
params.publish_dir_mode = 'link'
workflow.output.mode    = 'link'

// Slurm job name: the process's last name and its tag
executor.jobName = { task.name.replaceAll(/^[^(]*:/, '').replaceAll(/[^A-Za-z0-9_.-]+/, '_').replaceAll(/_+$/, '') }

process {
    // resources measured on heads: docs/RESOURCES.md; fqtk refuses fewer than 5 threads
    withName: 'FQTK'         { cpus = 5; memory = 2.GB; time = 1.h }
    withName: 'EXTRACT_LANE' { cpus = 1; memory = 1.GB; time = 1.h }
    withName: 'CAT_FASTQ'    { cpus = 1; memory = 1.GB; time = 1.h }
    // not measured: seqkit head streams the first N reads of each file
    withName: 'SEQKIT_HEAD'  { cpus = 1; memory = 1.GB; time = 1.h }
    withName: 'SEQUALI'      { cpus = 2; memory = 2.GB; time = 1.h }
    // not measured: placeholders until a hazel run
    withName: 'SEQKIT_SPLIT2'    { cpus = 4;  memory = 2.GB;  time = 1.h }
    withName: 'MINIBWA_MAP'      { cpus = 12; memory = 16.GB; time = 1.h }
    withName: 'FGUMI_CLIP'       { cpus = 2;  memory = 4.GB;  time = 1.h }
    withName: 'SAMTOOLS_FIXMATE' { cpus = 2;  memory = 1.GB;  time = 1.h }
    withName: 'SAMTOOLS_SORT'    { cpus = 6;  memory = 6.GB;  time = 1.h }
    withName: '.*FASTQ_ALIGN_MINIBWA:SAMTOOLS_MERGE'   { cpus = 4;  memory = 2.GB;  time = 1.h }
    withName: 'SAMTOOLS_MARKDUP' { cpus = 4;  memory = 4.GB;  time = 1.h }
    withName: 'SAMTOOLS_INDEX'   { cpus = 1;  memory = 1.GB;  time = 1.h }
    withName: 'SAMTOOLS_STATS'           { cpus = 2; memory = 2.GB; time = 1.h }
    withName: 'PICARD_COLLECTWGSMETRICS' { cpus = 1; memory = 5.GB; time = 1.h }
    withName: 'MOSDEPTH'                 { cpus = 1; memory = 4.GB; time = 1.h }
    withName: 'MULTIQC'                  { cpus = 1; memory = 2.GB; time = 1.h }
    // VARIANT_CALLING variant discovery: placeholders until the hazel resource profile
    withName: 'CHECK_COUNTS'            { cpus = 1; memory = 2.GB;  time = 1.h }
    withName: 'CHECK_ALT_RATE'          { cpus = 1; memory = 1.GB;  time = 1.h }
    withName: '.*CRAM_VARIANT_DISCOVERY_CRISP:SAMTOOLS_MERGE'          { cpus = 4; memory = 4.GB;  time = 1.h }
    withName: 'SAMTOOLS_ADDREPLACERG'   { cpus = 2; memory = 2.GB;  time = 1.h }
    withName: 'CRISP'                   { cpus = 1; memory = { 2.GB * task.attempt }; time = 2.h }
    withName: 'BED_CLIP|WITNESS_VETO'   { cpus = 1; memory = 1.GB;  time = 1.h }
    withName: 'BCFTOOLS_MPILEUP'        { cpus = 1; memory = 2.GB;  time = 1.h }
    withName: 'POOLED_LIKELIHOOD_TIERS' { cpus = 1; memory = 4.GB;  time = 1.h }
    // VARIANT_CALLING sites union and gap filling: measured on chr10:1-20 Mb (docs/RESOURCES.md)
    withName: 'BCFTOOLS_MERGE|BCFTOOLS_NORM|BIALLELIC_UNION|COUNT_UNION|DONOR_ALLELES_MERGE' { cpus = 1; memory = 1.GB; time = 1.h }
    // grow with donors x union sites: as hpc_prod
    withName: 'UNION_SITE_COUNTS|FILL_DONOR_ALLELES' { cpus = 1; memory = 4.GB; time = 1.h }
    withName: 'UNION_TIERS'                          { cpus = 1; memory = 8.GB; time = 1.h }
    // VARIANT_CALLING line counts, ANCESTRY grid: measured on the whole chr10 (docs/RESOURCES.md)
    withName: 'DONOR_SUBSET|DONOR_ALT_SITES|COUNT_LINES|ANCESTRY_GRID|ANCESTRY_VCF_INDEX' { cpus = 1; memory = 1.GB; time = 1.h }
    // RTIGER at union-ALT markers (Milestone 9a agent test, docs/RESOURCES.md)
    withName: 'CALL_ANCESTRY' { cpus = 1; memory = 2.GB; time = 1.h }
    // one task per sample, seconds each: Slurm job arrays well below queueSize, as CAT_FASTQ in hpc_prod
    withName: 'COUNT_UNION|COUNT_LINES' { array = 20 }
}
