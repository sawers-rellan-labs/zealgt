/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    hpc_dev: development runs on heads of one library
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Outputs published as hard links; work/ kept so -resume reruns only what changed.
----------------------------------------------------------------------------------------
*/

// outputs on /share as hard links: no extra space, and they outlive work/
params.publish_dir_mode = 'link'
workflow.output.mode    = 'link'

process {
    // measured on heads of 3-5 M pairs per lane: fqtk refuses fewer than 5 threads, peak 1.4-1.6 GB
    withName: 'FQTK'         { cpus = 5; memory = 2.GB; time = 1.h }
    withName: 'EXTRACT_LANE' { cpus = 1; memory = 1.GB; time = 1.h }
    withName: 'CAT_FASTQ'    { cpus = 1; memory = 1.GB; time = 1.h }
    // --head test runs only; not measured yet: seqkit head streams the first N reads of each file
    withName: 'SEQKIT_HEAD'  { cpus = 1; memory = 1.GB; time = 1.h }
    // measured: 0.4-0.5 GB, <10 s on 35-42 k pairs; 0.6 GB, 12 min, 1.3 cores on 236 M pairs (S_1C_6)
    withName: 'SEQUALI'      { cpus = 2; memory = 2.GB; time = 1.h }
    // measured on --head 4 M (21 k-573 k pairs per sample); <= 6 M pairs per sample takes minutes
    withName: 'MINIBWA_MAP'      { cpus = 12; memory = 16.GB; time = 1.h }
    withName: 'FGUMI_CLIP'       { cpus = 2;  memory = 4.GB;  time = 1.h }
    withName: 'SAMTOOLS_FIXMATE' { cpus = 2;  memory = 1.GB;  time = 1.h }
    withName: 'SAMTOOLS_SORT'    { cpus = 6;  memory = 6.GB;  time = 1.h }
    withName: 'SAMTOOLS_MARKDUP' { cpus = 4;  memory = 4.GB;  time = 1.h }
    withName: 'SAMTOOLS_INDEX'   { cpus = 1;  memory = 1.GB;  time = 1.h }
    // measured on --head 4 M: stats 1.7 cores, 0.8 GB, seconds; Picard 1 core, heap-bound 4.0 GB, 5-7 min genome walk;
    // mosdepth 1 core, 3.1 GB, under 1 min
    withName: 'SAMTOOLS_STATS'           { cpus = 2; memory = 2.GB; time = 1.h }
    withName: 'PICARD_COLLECTWGSMETRICS' { cpus = 1; memory = 5.GB; time = 1.h }
    withName: 'MOSDEPTH'                 { cpus = 1; memory = 4.GB; time = 1.h }
    // measured on 4 samples: 0.15 core, 0.7 GB, 1.5 min
    withName: 'MULTIQC'                  { cpus = 1; memory = 2.GB; time = 1.h }
}
