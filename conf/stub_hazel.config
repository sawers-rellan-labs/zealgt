/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Hazel stubs: Slurm job status polled every 10 s, every task 1 CPU / 1 GB / 10 min
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use: -stub -c <checkout>/conf/stub_hazel.config after -profile hpc_dev or hpc_prod; tests/hazel load it too.
    Tasks stay Slurm jobs: the local executor would start each task's Apptainer inside the Nextflow image, which fails.
----------------------------------------------------------------------------------------
*/

executor {
    queueStatInterval = '10s'
    pollInterval      = '10s'
}

process {
    // stub tasks only create files: the smallest request starts first; a later withName overrides the profiles'
    withName: '.*' {
        cpus   = 1
        memory = 1.GB
        time   = 10.min
    }
}
