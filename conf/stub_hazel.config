/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Hazel stubs: Slurm job status polled every 10 s instead of every minute
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use: -stub -c <checkout>/conf/stub_hazel.config, after -profile hpc_dev or hpc_prod (docs/running.md, "Stubs on hazel").
    Tasks stay Slurm jobs: the local executor would start each task's Apptainer inside the Nextflow image, which fails.
----------------------------------------------------------------------------------------
*/

executor {
    queueStatInterval = '10s'
    pollInterval      = '10s'
}
