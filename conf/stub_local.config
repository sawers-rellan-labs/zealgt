/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Hazel stubs: every task runs inside the head job, none as its own Slurm job
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use: -stub -c conf/stub_local.config, after -profile hpc_dev or hpc_prod (docs/running.md, "Stubs on hazel").
----------------------------------------------------------------------------------------
*/

process.executor = 'local'

process {
    // the local executor refuses job arrays; a later withName selector overrides the profiles' array settings
    withName: '.*' { array = 0 }
}

executor {
    // the profiles' resourceLimits, so the local executor accepts every request; stub tasks only create files
    $local {
        cpus   = 16
        memory = 120.GB
    }
}
