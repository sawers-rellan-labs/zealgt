/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run sawers-rellan-labs/zealgt -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 5, // fqtk refuses fewer than 5 threads
        memory: '15.GB',
        time: '1.h'
    ]
}

// CI runners have 4 cpus; the local executor may start fqtk's 5-cpu task anyway
executor.cpus = 5

params {
    // Input data: the demultiplexed fixture libraries, one per kit
    step   = 'alignment'
    input  = "${projectDir}/tests/fixtures/samplesheet_fastq.csv"

    // Reference: two-contig fixture and its minibwa 0.7 index
    fasta         = "${projectDir}/tests/fixtures/ref/tiny.fa"
    minibwa_index = "${projectDir}/tests/fixtures/ref/tiny.fa.{l2b,mbw}"
}
