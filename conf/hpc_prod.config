/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    hpc_prod: production runs on whole libraries
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Only CRAMs and QC are published; a successful run deletes its work/.
----------------------------------------------------------------------------------------
*/

cleanup = true

process {
    // fqtk: a full lane ~22 min (BC1) to ~42 min (batch 1), scaled from heads; the other two provisional
    withName: 'FQTK'         { cpus = 5; memory = 3.GB; time = 2.h }
    withName: 'EXTRACT_LANE' { cpus = 1; memory = 1.GB; time = 2.h }
}
