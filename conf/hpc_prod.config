/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    hpc_prod: production runs on whole libraries
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Outputs are copied (FASTQs for demultiplex, CRAMs and QC for alignment); a successful run deletes its work/.
----------------------------------------------------------------------------------------
*/

cleanup = true

process {
    // resources measured and estimated: docs/RESOURCES.md; fqtk time doubled for GPFS contention
    withName: 'FQTK'         { cpus = 5; memory = 3.GB; time = 2.h }
    // limits that may be short double on the retry (base.config retries once on exit 130-145)
    withName: 'EXTRACT_LANE' { cpus = 1; memory = 1.GB; time = { 30.min * task.attempt } }
    // job arrays of half of queueSize: an array as large as the queue waits for it to drain
    withName: 'CAT_FASTQ'    { cpus = 1; memory = 1.GB; time = 1.h; array = 20 }
    // alignment per chunk up to the sort, per sample from the merge; split and merge not measured yet
    withName: 'SEQKIT_SPLIT2'    { cpus = 4;  memory = 2.GB;  time = 2.h }
    withName: 'MINIBWA_MAP'      { cpus = 16; memory = 16.GB; time = 2.h }
    withName: 'FGUMI_CLIP'       { cpus = 2;  memory = 4.GB;  time = 2.h }
    withName: 'SAMTOOLS_FIXMATE' { cpus = 4;  memory = 1.GB;  time = 2.h }
    withName: 'SAMTOOLS_SORT'    { cpus = 6;  memory = 6.GB;  time = 1.h }
    withName: '.*FASTQ_ALIGN_MINIBWA:SAMTOOLS_MERGE'   { cpus = 4;  memory = 2.GB;  time = 2.h }
    withName: 'SAMTOOLS_MARKDUP' { cpus = 4;  memory = 8.GB;  time = 1.h }
    withName: 'SAMTOOLS_INDEX'   { cpus = 1;  memory = 1.GB;  time = 1.h }
    withName: 'SAMTOOLS_STATS'           { cpus = 2; memory = 2.GB; time = 2.h }
    // a deep sample past the short QOS limit retries once (base.config) on the normal QOS with a longer limit
    withName: 'PICARD_COLLECTWGSMETRICS' {
        cpus = 1; memory = 5.GB
        time           = { task.attempt > 1 ? 4.h : 2.h }
        queue          = { task.attempt > 1 ? 'compute' : 'compute_partners' }
        clusterOptions = { task.attempt > 1 ? '--account=maize_cpu --qos=normal' : '--account=maize_cpu --qos=short' }
        resourceLimits = [ cpus: 16, memory: 120.GB, time: 4.h ]
    }
    withName: 'MOSDEPTH'                 { cpus = 4; memory = 4.GB; time = 2.h }
    // Sequali 1.0.2 crashes on some samples inside the task wrapper (docs/RESOURCES.md): a failed report never stops a wave
    withName: 'SEQUALI'                  { cpus = 1; memory = 2.GB; time = 1.h; errorStrategy = 'ignore' }
    // grows with the sample count; provisional until a whole-library run
    withName: 'MULTIQC'                  { cpus = 1; memory = { 7.GB * task.attempt }; time = { 1.h * task.attempt } }
    // GENOTYPE variant discovery: placeholders until the hazel resource profile
    withName: 'CHECK_COUNTS'            { cpus = 1; memory = 2.GB;  time = 1.h }
    withName: 'CHECK_ALT_RATE'          { cpus = 1; memory = 1.GB;  time = 1.h }
    withName: '.*CRAM_VARIANT_DISCOVERY_CRISP:SAMTOOLS_MERGE'          { cpus = 4; memory = 4.GB;  time = 1.h }
    withName: 'SAMTOOLS_ADDREPLACERG'   { cpus = 2; memory = 2.GB;  time = 1.h }
    withName: 'CRISP'                   { cpus = 1; memory = 16.GB; time = 2.h }
    withName: 'BED_CLIP|WITNESS_VETO'   { cpus = 1; memory = 1.GB;  time = 1.h }
    withName: 'BCFTOOLS_MPILEUP'        { cpus = 1; memory = 2.GB;  time = 1.h }
    withName: 'POOLED_LIKELIHOOD_TIERS' { cpus = 1; memory = 4.GB;  time = 1.h }
    // GENOTYPE sites union and gap filling: placeholders until the hazel resource profile
    withName: 'BCFTOOLS_MERGE|BCFTOOLS_NORM|BIALLELIC_UNION' { cpus = 1; memory = 1.GB; time = 1.h }
    withName: 'COUNT_UNION'        { cpus = 1; memory = 2.GB; time = 1.h }
    withName: 'UNION_TIERS'        { cpus = 1; memory = 4.GB; time = 1.h }
    withName: 'FILL_DONOR_ALLELES' { cpus = 1; memory = 4.GB; time = 1.h }
}
