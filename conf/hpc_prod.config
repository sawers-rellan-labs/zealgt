/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    hpc_prod: production runs on whole libraries
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Only CRAMs and QC are published; a successful run deletes its work/.
----------------------------------------------------------------------------------------
*/

cleanup = true

process {
    // fqtk: RSS flat 1.6 GB, ~4.5 s per M pairs (BZea5 L001 heads to 50 M); largest batch-1 lane (BZea2, 77 GB) ~35 min; BC1 lanes unmeasured; the other two provisional
    withName: 'FQTK'         { cpus = 5; memory = 3.GB; time = 2.h }
    withName: 'EXTRACT_LANE' { cpus = 1; memory = 1.GB; time = 2.h }
    // many small tasks submitted as Slurm job arrays
    withName: 'CAT_FASTQ'    { cpus = 1; memory = 1.GB; time = 1.h; array = 50 }
    // per-pair rates from --head 4 M, scaled to deep BC1 samples (166-311 M pairs); minibwa outlives the short QOS
    withName: 'MINIBWA_MAP'      { cpus = 16; memory = 16.GB; time = 6.h; queue = 'compute'; clusterOptions = '--account=maize_cpu --qos=normal'; resourceLimits = [ cpus: 16, memory: 120.GB, time: 6.h ] }
    withName: 'FGUMI_CLIP'       { cpus = 2;  memory = 4.GB;  time = 2.h }
    withName: 'SAMTOOLS_FIXMATE' { cpus = 4;  memory = 1.GB;  time = 2.h }
    withName: 'SAMTOOLS_SORT'    { cpus = 6;  memory = 6.GB;  time = 1.h }
    withName: 'SAMTOOLS_MARKDUP' { cpus = 4;  memory = 8.GB;  time = 1.h }
    withName: 'SAMTOOLS_INDEX'   { cpus = 1;  memory = 1.GB;  time = 1.h }
    // memory as measured on --head 4 M (Picard heap-bound 4.0 GB, mosdepth 3.1 GB); times from the old repo at 310 M pairs
    // (stats 50 min, Picard 2 h 18 min, beyond the short QOS); mosdepth threads only help CRAM decoding at full size
    withName: 'SAMTOOLS_STATS'           { cpus = 2; memory = 2.GB; time = 2.h }
    withName: 'PICARD_COLLECTWGSMETRICS' { cpus = 1; memory = 5.GB; time = 4.h; queue = 'compute'; clusterOptions = '--account=maize_cpu --qos=normal'; resourceLimits = [ cpus: 16, memory: 120.GB, time: 6.h ] }
    withName: 'MOSDEPTH'                 { cpus = 4; memory = 4.GB; time = 2.h }
    // 0.7 GB, 1.5 min on 4 samples; grows with the sample count, provisional until a whole-library run
    // measured on a full 1C sample (236 M pairs, S_1C_6): 12 min, 1.3 of 2 cores, 0.6 GB peak
    withName: 'SEQUALI'                  { cpus = 2; memory = 2.GB; time = 1.h }
    withName: 'MULTIQC'                  { cpus = 1; memory = 4.GB; time = 1.h }
}
