{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/sawers-rellan-labs/zealgt/main/assets/schema_input.json",
    "title": "sawers-rellan-labs/zealgt pipeline - params.input schema",
    "description": "One row per sample; only the columns a process reads",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_]+$",
                "errorMessage": "sample_id must be letters, digits and underscores",
                "meta": ["id"]
            },
            "library": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_]+$",
                "errorMessage": "library must be letters, digits and underscores",
                "meta": ["library"]
            },
            "kit": {
                "type": "string",
                "enum": ["twist_flexprep", "twist_96plex"],
                "errorMessage": "kit must be twist_flexprep or twist_96plex",
                "meta": ["kit"]
            },
            "barcode_r1": {
                "type": "string",
                "pattern": "^[ACGT]+$",
                "errorMessage": "barcode_r1 must be an ACGT sequence",
                "meta": ["barcode_r1"]
            },
            "barcode_r2": {
                "type": "string",
                "pattern": "^[ACGT]*$",
                "errorMessage": "barcode_r2 must be an ACGT sequence or empty",
                "meta": ["barcode_r2"]
            },
            "exclude": {
                "type": "boolean",
                "default": false,
                "errorMessage": "exclude must be TRUE or FALSE",
                "meta": ["exclude"]
            },
            "raw_location": {
                "type": "string",
                "format": "directory-path",
                "exists": true,
                "errorMessage": "raw_location must be an existing directory"
            },
            "raw_r1": {
                "type": "string",
                "errorMessage": "raw_r1: <tar>:<member>;... for tar lanes, empty for plain lane files",
                "pattern": "^([^;:'\"\\s]+:[^;:'\"\\s]+(;[^;:'\"\\s]+:[^;:'\"\\s]+)*)?$"
            },
            "raw_r2": {
                "type": "string",
                "errorMessage": "raw_r2: <tar>:<member>;... for tar lanes, empty for plain lane files",
                "pattern": "^([^;:'\"\\s]+:[^;:'\"\\s]+(;[^;:'\"\\s]+:[^;:'\"\\s]+)*)?$"
            }
        },
        "required": ["sample_id", "library", "kit", "barcode_r1", "raw_location"]
    },
    "uniqueEntries": ["sample_id"]
}
